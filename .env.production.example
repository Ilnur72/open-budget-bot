# ============================================================
#  Production konfiguratsiyasi
#  Nusxa oling: cp .env.production.example .env.production
#  DIQQAT: .env.production ni git ga QO'SHMANG
# ============================================================

NODE_ENV=production
PORT=3000
APP_TIMEZONE=Asia/Tashkent

# --- Telegram ---
BOT_TOKEN=

# `webhook` — production, `polling` — development
BOT_MODE=webhook
# Nginx shu yo'lni botga uzatadi
WEBHOOK_URL=https://your-domain.com/telegram/webhook
# Kamida 16 belgi, faqat A-Z a-z 0-9 _ -
# Yaratish: openssl rand -hex 32
WEBHOOK_SECRET=

# Admin Telegram ID'lari, vergul bilan
ADMIN_IDS=

# --- Ma'lumotlar bazasi (docker-compose ichidagi nomlar) ---
DB_PASSWORD=
DATABASE_URL=postgresql://bot_user:${DB_PASSWORD}@postgres:5432/openbudget_bot

REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# --- OpenBudget ---
OPENBUDGET_BASE_URL=https://new.openbudget.uz
INITIATIVE_URL=https://new.openbudget.uz/uz/initiative-budget/active-initiatives/55/2f9c2e42-2e3c-46cb-a5af-bc7976cc0dec
DISTRICT_ID=55
INITIATIVE_UUID=2f9c2e42-2e3c-46cb-a5af-bc7976cc0dec
# Rasmiy Telegram botiga deep-link parametri (tashabbus public_id si)
INITIATIVE_PUBLIC_ID=055501602005
# Rasmiy bot foydalanuvchi nomi (@ siz)
OPENBUDGET_BOT=ochiqbudjetbot

# DevTools bilan endpointlarni tasdiqlagandan keyin true qiling.
# Usiz production rejimida ilova ISHGA TUSHMAYDI.
OPENBUDGET_ENDPOINTS_VERIFIED=false

# --- Captcha Mini App ---
WEBAPP_URL=https://your-domain.com/webapp/captcha.html
